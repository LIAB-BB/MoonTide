# Copy to .env and fill this locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

MOONTIDE_HOST=127.0.0.1
MOONTIDE_PORT=8000
MOONTIDE_ALLOWED_ORIGINS=https://liab-bb.github.io,http://127.0.0.1:8000,http://localhost:8000
MOONTIDE_RATE_LIMIT=12
MOONTIDE_DAILY_LIMIT=500
MOONTIDE_MODEL_CONCURRENCY=3

# Set to 1 only when the server is reachable exclusively through a trusted proxy
# that overwrites CF-Connecting-IP, such as Cloudflare Tunnel.
MOONTIDE_TRUST_PROXY=0
